OPENAI_API_KEY=sk-...
# Same engine family as ChatGPT Images 2.5. Use gpt-image-2.5-flare for faster, cheaper drafts.
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
# Used automatically if your key cannot access the model above
OPENAI_FALLBACK_MODEL=gpt-image-1.5
OPENAI_IMAGE_SIZE=1536x1024
OPENAI_IMAGE_QUALITY=high
# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=https://fabricnow.tonasel.com
# Optional: require this token for generation (users are prompted once)
ACCESS_TOKEN=
RATE_LIMIT_PER_HOUR=20
MAX_UPLOAD_MB=10
MAX_CONCURRENT_JOBS=3
RETENTION_HOURS=72
DATA_DIR=/data
ENV=production
# --- Vision: reads the photo, plans the pieces, reviews the drawn sheet, writes listings ---
# anthropic = use Claude first (falls back to OpenAI if that key is also set); openai = the reverse.
# The Claude API cannot draw images, so OPENAI_API_KEY is still required for the sheet, prints, colourways and mockups.
VISION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
OPENAI_VISION_MODEL=gpt-4.1
# 1 = a vision pass checks every drawn sheet (names pieces, finds missing ones, triggers a redraw)
SHEET_REVIEW=1
# Size of seamless print tiles
OPENAI_TILE_SIZE=1024x1024
# Photos allowed per batch request
MAX_BATCH=10
# Redraw once if the layout is clipped or pieces are missing (each attempt is billed)
MAX_ATTEMPTS=2
