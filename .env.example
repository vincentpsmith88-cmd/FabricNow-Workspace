# Style Backend URL
VITE_API_URL=http://localhost:4000

# Google OAuth Web client ID (ends in .apps.googleusercontent.com).
# Must be set in a file named ".env" in this folder, then restart `npm run dev`.
VITE_GOOGLE_CLIENT_ID=

# Optional: backend route that verifies the Google ID token (default below)
VITE_GOOGLE_AUTH_PATH=/api/auth/google
